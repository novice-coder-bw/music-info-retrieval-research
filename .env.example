# ==============================================================================
# Music Analysis Platform - Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env on the Droplet (/opt/mir/.env) or for local development.
# Never commit real credentials to version control.

# --- Domain & Tag (Production Droplet Compose) --------------------------------
DOMAIN=api.example.com
TAG=latest

# --- Database: Supabase PostgreSQL (Session Pooler Port 5432) -----------------
# Format: postgresql+psycopg2://postgres.<project_ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Example: postgresql+psycopg2://postgres.mghlumhhbjfeqvnmqrjs:your_supabase_password@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres.mghlumhhbjfeqvnmqrjs:YOUR_DB_PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# --- Broker & Cache: Redis ---------------------------------------------------
# On Droplet Compose, internal DNS points to redis:6379/0.
# Local development points to redis://localhost:6379/0.
REDIS_URL=redis://redis:6379/0

# --- Object Storage: Cloudflare R2 (S3-Compatible) ---------------------------
# Bucket name: music-info-retrieval-research-1
R2_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=music-info-retrieval-research-1
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# Public read base URL for browser audio streaming (r2.dev or custom domain)
R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# --- Authentication: Supabase Auth (JWKS) -------------------------------------
# Used to validate JWTs sent by the Lovable frontend
SUPABASE_JWKS_URL=https://mghlumhhbjfeqvnmqrjs.supabase.co/auth/v1/.well-known/jwks.json

# --- CORS & Security ---------------------------------------------------------
# Regex allowing Lovable frontend domains and local development
CORS_ORIGIN_REGEX=^https:\/\/(.*\.)?(lovable\.app|lovableproject\.com|pages\.dev)(:[0-9]+)?$

# Upload limit in megabytes (default: 100 MB)
MAX_UPLOAD_MB=100

# --- ML & Workers ------------------------------------------------------------
# Set to 0 in production so stem separation fails loudly if model is unavailable.
# Set to 1 only in CI/testing for dummy stems.
ALLOW_PLACEHOLDER_STEMS=0
SCRATCH_DIR=/scratch

# --- Music Analysis Platform optional infrastructure (Story 2.3) -----------
# Everything in this section is OPTIONAL. When unset, the platform runs entirely
# in degraded/local mode: sessions live in the in-memory SESSIONS dict plus an
# in-memory SQLite store, and raw audio + stems live in backend/uploads served
# from /uploads. No secrets are committed; copy this file to .env (gitignored)
# and fill in real values on the deployment host. The app loads .env via
# python-dotenv (host-injected env vars take precedence).

# Durable session store - Neon Postgres (managed serverless, SSL required).
# Example: postgresql://user:password@ep-<endpoint>.neon.tech/neondb?sslmode=require
# NOTE: after setting DATABASE_URL, create the schema ONCE from the repo root:
#   python3 -m alembic upgrade head
# The app does NOT auto-create tables on Postgres (they are alembic-versioned).
DATABASE_URL=

# Object storage - Cloudflare R2 (S3-compatible). The endpoint is derived from
# the account id (<ACCOUNT_ID>.r2.cloudflarestorage.com) when R2_ENDPOINT is
# left empty. Region is always 'auto' for R2.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# IMPORTANT: for the frontend to actually FETCH stored files, set this to a
# PUBLIC R2 domain (r2.dev subdomain or a custom domain attached to the bucket),
# NOT the private S3 API endpoint (which requires signed auth and returns
# 401/403 in the browser). Example: https://pub-<hash>.r2.dev
R2_PUBLIC_BASE_URL=